+    #[test]
+    fn valid_unreachable_target_still_reports_no_route_to_target() {
+        let snapshot = GameSnapshot {
+            source: "test".to_owned(),
+            token: "valid-unreachable".to_owned(),
+            round_id: None,
+            field: vec![
+                [false, false, false, false, false, false, false, false, false, false],
+                [false, false, false, false, false, false, false, false, false, false],
+                [false, false, false, false, false, false, false, false, false, false],
+                [true, false, false, false, false, false, false, false, false, true],
+                [true, true, true, true, false, false, false, true, true, true],
+                [true, true, true, true, false, false, false, true, true, true],
+            ]
+            .into_iter()
+            .chain(std::iter::repeat([false; 10]).take(34))
+            .collect(),
+            queue: vec![PieceToken::J, PieceToken::O, PieceToken::T, PieceToken::L],
+            hold: None,
+            combo: 0,
+            b2b: false,
+            incoming: 0,
+            piece_counter: Some(1),
+            lines_cleared: None,
+            playing: true,
+            countdown: false,
+            active: Some(ActivePieceState {
+                x: 4,
+                y: 17,
+                rotation: RotationToken::North,
+            }),
+        };
+        let board = board_from_snapshot(&snapshot).expect("board should build");
+        let spawned =
+            active_piece_for_execution(&snapshot, false, Piece::J).expect("active J should exist");
+        let reachable_locations = find_moves(&board, spawned, MovementMode::ZeroGComplete)
+            .into_iter()
+            .map(|placement| placement.location.canonical())
+            .collect::<Vec<_>>();
+        let mut target = None;
+        for rotation in [
+            RotationState::North,
+            RotationState::East,
+            RotationState::South,
+            RotationState::West,
+        ] {
+            for y in 0..40 {
+                for x in 0..10 {
+                    let candidate = FallingPiece {
+                        kind: PieceState(Piece::J, rotation),
+                        x,
+                        y,
+                        tspin: TspinStatus::None,
+                    }
+                    .canonical();
+                    if candidate
+                        .cells()
+                        .iter()
+                        .any(|(cell_x, cell_y)| *cell_x < 0 || *cell_x >= 10 || *cell_y < 0 || *cell_y >= 40)
+                    {
+                        continue;
+                    }
+                    let validation = validate_target_on_board(&board, candidate);
+                    if validation.valid
+                        && !reachable_locations
+                            .iter()
+                            .any(|reachable| reachable.same_location(&candidate))
+                    {
+                        target = Some(candidate);
+                        break;
+                    }
+                }
+                if target.is_some() {
+                    break;
+                }
+            }
+            if target.is_some() {
+                break;
+            }
+        }
+        let target = target.expect("board should contain a valid but unreachable J placement");
+
+        let mut config = AutomationConfig::default();
+        config.bot.movement_mode = MovementModeConfig::ZeroGSafe;
+        let result = prepare_snapshot_execution_attempt(
+            &config,
+            &snapshot,
+            PieceToken::J,
+            Move {
+                inputs: Default::default(),
+                expected_location: target,
+                hold: false,
+            },
+            "normal nodes=1 depth=1 rank=0".to_owned(),
+            MovementModeConfig::ZeroGSafe,
+            None,
+            None,
+            None,
+        )
+        .expect("attempt should return a skipped result");
+
+        match result {
+            PreparedSnapshotExecutionResult::Skipped {
+                reason,
+                retryable,
+                diagnostic: Some(PreparedSnapshotSkipDiagnostic::NoRoute(diagnostic)),
+            } => {
+                assert!(retryable);
+                assert!(reason.starts_with("no_route_to_target"));
+                assert_eq!(diagnostic.target_x, target.x);
+                assert_eq!(diagnostic.target_y, target.y);
+            }
+            other => panic!("expected no-route skip, got {other:?}"),
+        }
+    }
