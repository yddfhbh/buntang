+fn average_nonzero_perf_ms(samples: &VecDeque<u128>) -> u128 {
+    let mut count = 0usize;
+    let mut total = 0u128;
+    for sample in samples {
+        if *sample == 0 {
+            continue;
+        }
+        count += 1;
+        total += *sample;
+    }
+    if count == 0 {
+        0
+    } else {
+        total / count as u128
+    }
