+fn friendly_vs_execution_piece(
+    snapshot: &FriendlyVsPassivePlannerSnapshot,
+    use_hold: bool,
+) -> Option<PieceToken> {
+    if !use_hold {
+        return snapshot.snapshot.queue.first().copied();
+    }
+    snapshot
+        .snapshot
+        .hold
+        .or_else(|| snapshot.snapshot.queue.get(1).copied())
+}
+
+fn evaluate_friendly_vs_hold_transition(
+    before: &FriendlyVsPendingHoldTransition,
+    after: &FriendlyVsPassivePlannerSnapshot,
+) -> FriendlyVsHoldTransitionEvaluation {
+    let before_current = before.before_current;
+    let before_hold = before.before_hold;
+    let after_current = after.snapshot.queue.first().copied();
+    let after_hold = after.snapshot.hold;
+    let before_piece_counter = before.before_piece_counter;
+    let after_piece_counter = after.snapshot.piece_counter;
+    let hold_changed = before_hold != after_hold;
+    let queue_changed = before.before_queue_prefix
+        != after
+            .snapshot
+            .queue
+            .iter()
+            .take(before.before_queue_prefix.len())
+            .copied()
+            .collect::<Vec<_>>();
+    let pair_changed = before_current != after_current || hold_changed;
+    let piece_counter_changed = before_piece_counter != after_piece_counter;
+
+    let occupied_hold_swap = before_hold.is_some()
+        && after_current == before_hold
+        && after_hold == before_current
+        && (hold_changed || queue_changed || pair_changed);
+    if occupied_hold_swap {
+        return FriendlyVsHoldTransitionEvaluation {
+            confirmed: true,
+            reason: "occupied_hold_swap",
+            before_current,
+            before_hold,
+            after_current,
+            after_hold,
+            before_piece_counter,
+            after_piece_counter,
+            hold_changed,
+            queue_changed,
+            pair_changed,
+            piece_counter_changed,
+        };
+    }
+
+    let empty_hold_transition = before_hold.is_none()
+        && after_hold == before_current
+        && (hold_changed || queue_changed || pair_changed);
+    if empty_hold_transition {
+        return FriendlyVsHoldTransitionEvaluation {
+            confirmed: true,
+            reason: "empty_hold_transition",
+            before_current,
+            before_hold,
+            after_current,
+            after_hold,
+            before_piece_counter,
+            after_piece_counter,
+            hold_changed,
+            queue_changed,
+            pair_changed,
+            piece_counter_changed,
+        };
+    }
+
+    FriendlyVsHoldTransitionEvaluation {
+        confirmed: false,
+        reason: if !hold_changed && !queue_changed && !pair_changed && !piece_counter_changed {
+            "no_transition_evidence"
+        } else if piece_counter_changed && !hold_changed {
+            "piece_counter_changed_without_hold_evidence"
+        } else {
+            "transition_fingerprint_mismatch"
+        },
+        before_current,
+        before_hold,
+        after_current,
+        after_hold,
+        before_piece_counter,
+        after_piece_counter,
+        hold_changed,
+        queue_changed,
+        pair_changed,
+        piece_counter_changed,
+    }
+}
