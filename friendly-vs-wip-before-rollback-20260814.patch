+pub(crate) fn friendly_vs_active_board_overlap_diagnostic(
+    snapshot: &GameSnapshot,
+) -> Result<Option<ActiveBoardOverlapDiagnostic>> {
+    let Some(active) = snapshot.active else {
+        return Ok(None);
+    };
+    let Some(current_piece) = snapshot.queue.first().copied() else {
+        return Ok(None);
+    };
+    let authoritative_board = board_from_snapshot(snapshot)?;
+    let overlap_cells = FallingPiece {
+        kind: PieceState(piece_token_to_piece(current_piece), active.rotation.into()),
+        x: active.x,
+        y: active.y,
+        tspin: libtetris::TspinStatus::None,
+    }
+    .cells()
+    .into_iter()
+    .filter(|(x, y)| authoritative_board.occupied(*x, *y))
