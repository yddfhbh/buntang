+        let (x, y) = zenith_spawn_coordinates(match current_piece {
+            "I" => Piece::I,
+            "O" => Piece::O,
+            "T" => Piece::T,
+            "L" => Piece::L,
+            "J" => Piece::J,
+            "S" => Piece::S,
+            "Z" => Piece::Z,
+            _ => Piece::J,
+        });
+        let board = vec![vec![serde_json::Value::Bool(false); 10]; 40];
+        json!({
+            "status": "ready",
+            "capture_status": "running",
+            "snapshot": {
+                "source": "friendly_vs_passive",
+                "round_id": round_id,
+                "capture_generation": capture_generation,
+                "timestamp": 1722422401123u64,
+                "userid": userid,
+                "gameid": gameid,
+                "candidate_id": candidate_id,
+                "playing": true,
+                "started": true,
+                "countdown_started": false,
+                "paused": false,
+                "destroyed": false,
+                "successful": false,
+                "gameoverreason": null,
+                "board": board,
+                "current": {
+                    "type": current_piece,
+                    "x": x,
+                    "y": y,
+                    "rotation": "north"
+                },
+                "hold": hold_piece,
+                "queue": queue,
+                "piece_counter": piece_counter
+            }
+        })
+    }
