+struct FriendlyVsNoRouteFingerprint {
+    round_id: String,
+    gameid: String,
+    capture_generation: u64,
+    candidate_id: String,
+    piece_counter: Option<u32>,
+    current_signature: String,
+    board_hash: u64,
+    target_piece: PieceToken,
+    target_x: i32,
+    target_y: i32,
+    target_rotation: RotationToken,
+    reason: String,
+}
+
+impl FriendlyVsNoRouteFingerprint {
+    fn from_snapshot_and_diagnostic(
+        snapshot: &FriendlyVsPassivePlannerSnapshot,
+        diagnostic: &RouteSearchFailureDiagnostic,
+    ) -> Self {
+        Self {
+            round_id: snapshot.round_id.clone(),
+            gameid: snapshot.gameid.clone(),
+            capture_generation: snapshot.capture_generation,
+            candidate_id: snapshot.candidate_id.clone(),
+            piece_counter: snapshot.snapshot.piece_counter,
+            current_signature: snapshot.current_signature.clone(),
+            board_hash: diagnostic.board_hash,
+            target_piece: diagnostic.target_piece,
+            target_x: diagnostic.target_x,
+            target_y: diagnostic.target_y,
+            target_rotation: diagnostic.target_rotation,
+            reason: diagnostic.reason.clone(),
+        }
+    }
+
+    fn matches_snapshot(&self, snapshot: &FriendlyVsPassivePlannerSnapshot) -> bool {
+        self.round_id == snapshot.round_id
+            && self.gameid == snapshot.gameid
+            && self.capture_generation == snapshot.capture_generation
+            && self.candidate_id == snapshot.candidate_id
+            && self.piece_counter == snapshot.snapshot.piece_counter
+            && self.current_signature == snapshot.current_signature
+            && self.board_hash == friendly_vs_route_failure_board_hash(&snapshot.snapshot.field)
+    }
+
+    fn skip_key(&self) -> String {
+        format!(
+            "duplicate_route_failure:{}:{}:{}:{}:{}:{}:{}:{}:{}:{}:{:?}:{}:{}",
+            self.round_id,
+            self.gameid,
+            self.capture_generation,
+            self.candidate_id,
+            piece_counter_label(self.piece_counter),
+            self.board_hash,
+            stable_hash(&self.current_signature),
+            self.target_piece.label(),
+            self.target_x,
+            self.target_y,
+            format!("{:?}", self.target_rotation),
+            route_failure_family(&self.reason),
+            self.reason
+        )
+    }
+}
+
+fn friendly_vs_route_failure_board_hash(field: &[[bool; 10]]) -> u64 {
+    let mut hash = 1469598103934665603u64;
+    for row in field {
+        for cell in row {
+            hash ^= u64::from(*cell as u8);
+            hash = hash.wrapping_mul(1099511628211);
+        }
+    }
+    hash
+}
+
+fn is_friendly_vs_route_failure_reason(reason: &str) -> bool {
+    reason.starts_with("no_route_to_target")
+        || reason.starts_with("post_softdrop_horizontal_blocked")
+        || reason.starts_with("post_softdrop_actions_disabled")
+        || reason.starts_with("soft_drop_post_actions_blocked")
+}
+
+fn route_failure_family(reason: &str) -> &'static str {
+    if reason.starts_with("no_route_to_target") {
+        "no_route_to_target"
+    } else if reason.starts_with("post_softdrop_horizontal_blocked") {
+        "post_softdrop_horizontal_blocked"
+    } else if reason.starts_with("post_softdrop_actions_disabled")
+        || reason.starts_with("soft_drop_post_actions_blocked")
+    {
+        "post_softdrop_blocked"
+    } else {
+        "route_failure"
+    }
+}
 
