+export function sanitizeChromiumStderrLine(line, maxLength = 200) {
+  const sanitized = `${line ?? ""}`
+    .replace(/[\u0000-\u001f\u007f]+/g, " ")
+    .trim();
+  if (!sanitized) {
+    return "";
+  }
+  if (sanitized.length <= maxLength) {
+    return sanitized;
+  }
+  return `${sanitized.slice(0, Math.max(0, maxLength - 3))}...`;
+}
+
+export function createChromiumStderrTail(maxLines = 20) {
+  const lines = [];
+  let partial = "";
+  return {
+    push(chunk) {
+      partial += `${chunk ?? ""}`;
+      const segments = partial.split(/\r?\n/);
+      partial = segments.pop() ?? "";
+      for (const segment of segments) {
+        const sanitized = sanitizeChromiumStderrLine(segment);
+        if (!sanitized) continue;
+        lines.push(sanitized);
+        if (lines.length > maxLines) {
+          lines.splice(0, lines.length - maxLines);
+        }
+      }
+    },
+    flush() {
+      const sanitized = sanitizeChromiumStderrLine(partial);
+      partial = "";
+      if (sanitized) {
+        lines.push(sanitized);
+        if (lines.length > maxLines) {
+          lines.splice(0, lines.length - maxLines);
+        }
+      }
+      return [...lines];
+    }
+  };
+}
+
+export function formatChromiumExitLog({ code, signal, expected, uptimeMs }) {
+  const exitCode = Number.isInteger(code) ? code : "null";
+  const exitSignal = signal ?? "none";
+  return `[browser-host] Chromium exited expected=${expected ? "true" : "false"} exit_code=${exitCode} signal=${exitSignal} uptime_ms=${Math.max(0, Math.trunc(uptimeMs ?? 0))}`;
+}
