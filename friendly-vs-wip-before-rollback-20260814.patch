+fn format_route_search_diagnostic(
+    snapshot: &FriendlyVsPassivePlannerSnapshot,
+    diagnostic: &RouteSearchFailureDiagnostic,
+) -> String {
+    let fingerprint =
+        FriendlyVsNoRouteFingerprint::from_snapshot_and_diagnostic(snapshot, diagnostic);
+    let header = if route_failure_family(&diagnostic.reason) == "no_route_to_target" {
+        "[friendly-vs-route] no route"
+    } else {
+        "[friendly-vs-route] route failure"
+    };
+    let mut lines = vec![
+        header.to_owned(),
+        format!("round_id={}", snapshot.round_id),
+        format!("gameid={}", snapshot.gameid),
+        format!("generation={}", snapshot.capture_generation),
+        format!("candidate_id={}", snapshot.candidate_id),
+        format!(
+            "piece_counter={}",
+            piece_counter_label(snapshot.snapshot.piece_counter)
+        ),
+        format!(
+            "current={}",
+            snapshot
+                .snapshot
+                .queue
+                .first()
+                .copied()
+                .map(|piece| piece.label())
+                .unwrap_or("?")
+        ),
+        format!("from_x={}", diagnostic.from_x),
+        format!("from_y={}", diagnostic.from_y),
+        format!("from_rotation={:?}", diagnostic.from_rotation),
+        format!("target_piece={}", fingerprint.target_piece.label()),
+        format!("target_x={}", diagnostic.target_x),
+        format!("target_y={}", diagnostic.target_y),
+        format!("target_rotation={:?}", diagnostic.target_rotation),
+        format!("use_hold={}", diagnostic.use_hold),
+        format!("board_hash={}", diagnostic.board_hash),
+        format!("current_signature={}", snapshot.current_signature),
+        format!(
+            "signature_hash={}",
+            stable_hash(&snapshot.current_signature)
+        ),
+        format!(
+            "stack_height_estimate={}",
+            stack_height_estimate(&snapshot.snapshot.field)
+        ),
+        format!("candidate_count={}", diagnostic.candidate_count),
+        format!("rejected_count={}", diagnostic.rejected_count),
+        format!("reason={}", diagnostic.reason),
+    ];
+    if !diagnostic.rejected_route_samples.is_empty() {
+        lines.push(format!(
+            "rejected_route_samples={}",
+            diagnostic.rejected_route_samples.join(" | ")
+        ));
+    }
+    lines.join("\n")
+}
