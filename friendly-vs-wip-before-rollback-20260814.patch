+    fn poll_friendly_vs_live_test_piece(
+        app: &mut LauncherApp,
+        paths: &AppPaths,
+        round_id: &str,
+        piece_counter: u32,
+        sequence_index: usize,
+    ) {
+        let patterns = [
+            ("J", ["O", "T", "L", "S", "Z"]),
+            ("T", ["I", "O", "L", "S", "Z"]),
+            ("L", ["I", "O", "T", "S", "Z"]),
+            ("S", ["I", "O", "T", "L", "Z"]),
+            ("Z", ["I", "O", "T", "L", "S"]),
+            ("I", ["O", "T", "L", "S", "Z"]),
+        ];
+        let (current_piece, queue) = patterns[sequence_index % patterns.len()];
+        let gameid = round_id.split(':').next().unwrap_or("7001");
+        std::thread::sleep(Duration::from_millis(20));
+        write_friendly_vs_passive_snapshot(
+            paths,
+            round_id,
+            gameid,
+            "cand-local",
+            piece_counter,
+            json!("friendly-user"),
+            current_piece,
+            &queue,
+        );
+        app.poll_friendly_vs_dry_run();
+    }
