+fn format_friendly_vs_placement_summary(
+    route_kind: &str,
+    aggregate: FriendlyVsPlacementAggregate,
+) -> String {
+    let resolved = aggregate
+        .confirmed_match
+        .saturating_add(aggregate.confirmed_mismatch);
+    let mismatch_rate = if resolved == 0 {
+        0.0
+    } else {
+        aggregate.confirmed_mismatch as f64 / resolved as f64
+    };
+    format!(
+        "[friendly-vs-placement-summary] route={} confirmed_match={} confirmed_mismatch={} ambiguous={} unresolved={} mismatch_rate={:.3}",
+        route_kind,
+        aggregate.confirmed_match,
+        aggregate.confirmed_mismatch,
+        aggregate.ambiguous,
+        aggregate.unresolved,
+        mismatch_rate
+    )
+}
