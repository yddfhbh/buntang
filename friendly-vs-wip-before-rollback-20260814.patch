+fn invalid_planner_target_diagnostic(
+    snapshot: &GameSnapshot,
+    active_piece: PieceToken,
+    planned_move: &Move,
+) -> Result<Option<InvalidPlannerTargetDiagnostic>> {
+    let authoritative_board = board_from_snapshot(snapshot)?;
+    let planner_input_field = snapshot.field_array()?;
+    let planner_input_board = Board::new_with_state(
+        planner_input_field,
+        enumset::EnumSet::all(),
+        snapshot.hold_piece(),
+        snapshot.b2b,
+        snapshot.combo,
+    );
+    let authoritative_validation =
+        validate_target_on_board(&authoritative_board, planned_move.expected_location);
+    let planner_validation = validate_target_on_board(&planner_input_board, planned_move.expected_location);
+    let active_overlap_cells = snapshot
+        .active
+        .map(|active| {
+            FallingPiece {
+                kind: PieceState(piece_token_to_piece(active_piece), active.rotation.into()),
+                x: active.x,
+                y: active.y,
+                tspin: libtetris::TspinStatus::None,
+            }
+            .cells()
+            .into_iter()
+            .filter(|(x, y)| authoritative_board.occupied(*x, *y))
+            .collect::<Vec<_>>()
+        })
+        .unwrap_or_default();
+    if authoritative_validation.valid {
+        return Ok(None);
+    }
+    Ok(Some(InvalidPlannerTargetDiagnostic {
+        current_piece: active_piece,
+        target_piece: piece_token_from_piece(planned_move.expected_location.kind.0),
+        use_hold: planned_move.hold,
+        target_x: planned_move.expected_location.x,
+        target_y: planned_move.expected_location.y,
+        target_rotation: rotation_token_from_state(planned_move.expected_location.kind.1),
+        active_overlap_count: active_overlap_cells.len(),
+        active_overlap_cells,
+        authoritative: board_topology_diagnostic(&authoritative_board.get_field()),
+        planner_input: board_topology_diagnostic(&planner_input_board.get_field()),
+        authoritative_validation,
+        planner_validation,
+    }))
+}
