+fn friendly_vs_semantic_invalid_state(
+    envelope: &FriendlyVsPassiveSnapshotEnvelope,
+) -> &'static str {
+    if envelope.semantic_error.is_some() {
+        return "bound_snapshot_invalid";
+    }
+    if envelope.snapshot.is_none() && envelope.capture_status.as_deref() == Some("running") {
+        return match envelope.reason.as_deref() {
+            Some("capture_timed_out") => "capture_timed_out",
+            _ => "waiting_for_capture",
+        };
+    }
+    match envelope.reason.as_deref() {
+        Some("awaiting_gameplay_frame") => "waiting_for_capture",
+        Some("capture_timed_out") => "capture_timed_out",
+        _ => "other",
+    }
+}
