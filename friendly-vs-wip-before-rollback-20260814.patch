+#[derive(Clone, Debug)]
+struct FriendlyVsLiveDispatchDiagnostic {
+    route_kind: String,
+    stack_height_estimate: usize,
+    rotation_sensitive: bool,
+    rotation_count: usize,
+    use_hold: bool,
+    active_x: Option<i32>,
+    active_y: Option<i32>,
+    active_rotation: Option<RotationToken>,
+    target_piece: Option<PieceToken>,
+    target_x: i32,
+    target_y: i32,
+    target_rotation: RotationToken,
+    actions: Vec<GameAction>,
+    pre_field: Vec<[bool; 10]>,
+    pre_field_hash: u64,
+    expected_post_field: Option<Vec<[bool; 10]>>,
+    expected_post_field_hash: Option<u64>,
+    expected_lines_cleared: Option<usize>,
+    expected_post_unavailable_reason: Option<&'static str>,
+    expected_signature_hash: u64,
+    incoming_garbage_before: Option<usize>,
+}
+
+impl FriendlyVsLiveDispatchDiagnostic {
+    fn capture(
+        snapshot: &FriendlyVsPassivePlannerSnapshot,
+        prepared: &PreparedSnapshotExecution,
+        bridge_observation: Option<&crate::vs_sim::VsBridgeObservation>,
+    ) -> Result<Option<Self>> {
+        let stack_height_estimate = stack_height_estimate(&snapshot.snapshot.field);
+        let rotation_count = rotation_action_count(&prepared.summary.actions);
+        let rotation_sensitive = rotation_count > 0;
+        let should_log = stack_height_estimate
+            >= FRIENDLY_VS_LIVE_ROUTE_DIAGNOSTIC_STACK_HEIGHT_THRESHOLD
+            || prepared.summary.route_kind != "NoSoftDrop"
+            || (prepared.summary.use_hold && rotation_count >= 2);
+        if !should_log {
+            return Ok(None);
+        }
+        let (expected_post_field, expected_post_field_hash, expected_lines_cleared, expected_post_unavailable_reason) =
+            if prepared.summary.route_kind == "TemporarySoftDropTerminalHardDrop" {
+                (None, None, None, Some("temporary_terminal_progress"))
+            } else {
+                match simulate_friendly_vs_expected_post_state(snapshot, prepared) {
+                    Ok(expected_post_state) => (
+                        Some(expected_post_state.field.clone()),
+                        Some(stable_hash(&expected_post_state.field)),
+                        Some(expected_post_state.lines_cleared),
+                        None,
+                    ),
+                    Err(err) => (
+                        None,
+                        None,
+                        None,
+                        Some(friendly_vs_expected_post_unavailable_reason(&err)),
+                    ),
+                }
+            };
+        Ok(Some(Self {
+            route_kind: prepared.summary.route_kind.clone(),
+            stack_height_estimate,
+            rotation_sensitive,
+            rotation_count,
+            use_hold: prepared.summary.use_hold,
+            active_x: snapshot.snapshot.active.as_ref().map(|active| active.x),
+            active_y: snapshot.snapshot.active.as_ref().map(|active| active.y),
+            active_rotation: snapshot
+                .snapshot
+                .active
+                .as_ref()
+                .map(|active| active.rotation),
+            target_piece: friendly_vs_execution_piece(snapshot, prepared.summary.use_hold),
+            target_x: prepared.summary.target_x,
+            target_y: prepared.summary.target_y,
+            target_rotation: prepared.summary.target_rotation,
+            actions: prepared.summary.actions.clone(),
+            pre_field: snapshot.snapshot.field.clone(),
+            pre_field_hash: stable_hash(&snapshot.snapshot.field),
+            expected_post_field_hash,
+            expected_lines_cleared,
+            expected_post_field,
+            expected_post_unavailable_reason,
+            expected_signature_hash: stable_hash(&snapshot.current_signature),
+            incoming_garbage_before: bridge_observation
+                .map(|observation| observation.incoming_garbage_count),
+        }))
+    }
+
+    fn pre_dispatch_log(&self, snapshot: &FriendlyVsPassivePlannerSnapshot) -> String {
+        format!(
+            "[friendly-vs-live] route diagnostic round_id={} gameid={} piece_counter={} current={} route={} stack_height_estimate={} rotation_sensitive={} rotation_count={} use_hold={} active_x={} active_y={} active_rotation={} target_piece={} target_x={} target_y={} target_rotation={:?} pre_field_hash={} expected_post_field_hash={} expected_lines_cleared={} incoming_garbage_before={} actions={:?}",
+            snapshot.round_id,
+            snapshot.gameid,
+            piece_counter_label(snapshot.snapshot.piece_counter),
+            snapshot
+                .snapshot
+                .queue
+                .first()
+                .copied()
+                .map(|piece| piece.label())
+                .unwrap_or("?"),
+            self.route_kind,
+            self.stack_height_estimate,
+            self.rotation_sensitive,
+            self.rotation_count,
+            self.use_hold,
+            optional_i32_label(self.active_x),
+            optional_i32_label(self.active_y),
+            optional_rotation_label(self.active_rotation),
+            self.target_piece
+                .map(|piece| piece.label().to_owned())
+                .unwrap_or_else(|| "?".to_owned()),
+            self.target_x,
+            self.target_y,
+            self.target_rotation,
+            self.pre_field_hash,
+            self.expected_post_field_hash
+                .map(|value| value.to_string())
+                .unwrap_or_else(|| "unknown".to_owned()),
+            self.expected_lines_cleared
+                .map(|value| value.to_string())
+                .unwrap_or_else(|| "unknown".to_owned()),
+            self.incoming_garbage_before
+                .map(|value| value.to_string())
+                .unwrap_or_else(|| "unknown".to_owned()),
+            self.actions
+        )
+    }
+}
+
+fn rotation_action_count(actions: &[GameAction]) -> usize {
+    actions
+        .iter()
+        .filter(|action| matches!(action, GameAction::RotateCw | GameAction::RotateCcw))
+        .count()
+}
+
+fn lateral_action_count(actions: &[GameAction]) -> usize {
+    actions
+        .iter()
+        .filter(|action| matches!(action, GameAction::Left | GameAction::Right))
+        .count()
+}
+
+fn stack_height_estimate(field: &[[bool; 10]]) -> usize {
+    field
+        .iter()
+        .rposition(|row| row.iter().any(|filled| *filled))
+        .map(|index| index.saturating_add(1))
+        .unwrap_or(0)
+}
+
+fn stable_hash<T: Hash>(value: &T) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    value.hash(&mut hasher);
+    hasher.finish()
+}
+
+fn optional_i32_label(value: Option<i32>) -> String {
+    value
+        .map(|value| value.to_string())
+        .unwrap_or_else(|| "unknown".to_owned())
+}
+
+fn optional_rotation_label(value: Option<RotationToken>) -> String {
+    value
+        .map(|rotation| format!("{rotation:?}"))
+        .unwrap_or_else(|| "unknown".to_owned())
+}
+
+fn spawn_rule_label(rule: SpawnRuleConfig) -> &'static str {
+    match rule {
+        SpawnRuleConfig::Row19Or20 => "Row 19 or 20",
+        SpawnRuleConfig::Row21AndFall => "Row 21 and fall",
+    }
+}
+
+fn extract_planned_token(line: &str) -> Option<String> {
+    if !line.contains("[automation] source=") || !line.contains(" piece=") {
+        return None;
+    }
+    line.split_whitespace()
+        .find_map(|part| part.strip_prefix("token=").map(|value| value.to_owned()))
+}
+
+fn extract_snapshot_epoch(token: &str) -> Option<u64> {
+    let mut parts = token.split('-');
+    let prefix = parts.next()?;
+    let epoch = parts.next()?;
+    let _piece_counter = parts.next()?;
+    if prefix != "browser" || parts.next().is_some() {
+        return None;
+    }
+    epoch.parse().ok()
+}
+
+fn line_reports_runner_waiting(line: &str) -> bool {
+    line.contains("[automation] idle waiting for next live game after token=")
+}
+
+fn extract_resumed_epoch_from_bot_log(line: &str) -> Option<u64> {
+    if !line.contains("[automation] live game resumed token=") {
+        return None;
+    }
+    line.split_whitespace()
+        .find_map(|part| part.strip_prefix("token="))
+        .and_then(extract_snapshot_epoch)
+}
