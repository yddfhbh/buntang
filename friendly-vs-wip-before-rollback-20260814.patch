+fn percentile_ms(mut values: Vec<u128>, percentile: usize) -> u128 {
+    if values.is_empty() {
+        return 0;
+    }
+    values.sort_unstable();
+    let last_index = values.len().saturating_sub(1);
+    let index = last_index.saturating_mul(percentile).div_ceil(100);
+    values[index.min(last_index)]
+}
+
+fn average_ms(values: impl Iterator<Item = u128>, count: usize) -> u128 {
+    if count == 0 {
+        return 0;
+    }
+    values.sum::<u128>() / count as u128
+}
+
+fn average_nonzero_ms(values: impl Iterator<Item = u128>) -> u128 {
+    let mut count = 0usize;
+    let mut total = 0u128;
+    for value in values {
+        if value == 0 {
+            continue;
+        }
+        count += 1;
+        total += value;
+    }
+    if count == 0 {
+        0
+    } else {
+        total / count as u128
+    }
+}
+
+fn format_friendly_vs_perf_report(samples: &[FriendlyVsLivePerfSample]) -> String {
+    let placements = samples.len();
+    if placements == 0 {
+        return "[friendly-vs-perf] placements=0".to_owned();
+    }
+    let total_effective_ms = samples
+        .iter()
+        .map(|sample| sample.total_cycle_ms + sample.wait_for_next_piece_ms)
+        .sum::<u128>();
+    let effective_pps = if total_effective_ms == 0 {
+        0.0
+    } else {
+        (placements as f64 * 1000.0) / total_effective_ms as f64
+    };
+    let actual_dispatch_interval_avg_ms =
+        average_nonzero_ms(samples.iter().map(|sample| sample.actual_dispatch_interval_ms));
+    let actual_dispatch_pps = if actual_dispatch_interval_avg_ms == 0 {
+        0.0
+    } else {
+        1000.0 / actual_dispatch_interval_avg_ms as f64
+    };
+    let cycle_values = samples
+        .iter()
+        .map(|sample| sample.total_cycle_ms)
+        .collect::<Vec<_>>();
+    let route_mix = samples.iter().fold(
+        std::collections::BTreeMap::<String, usize>::new(),
+        |mut counts, sample| {
+            *counts.entry(sample.route_kind.clone()).or_default() += 1;
+            counts
+        },
+    );
+    let route_summary = route_mix
+        .into_iter()
+        .map(|(route, count)| format!("{route}:{count}"))
+        .collect::<Vec<_>>()
+        .join(",");
+    format!(
+        "[friendly-vs-perf] placements={} effective_pps={:.2} actual_dispatch_interval_avg_ms={} actual_dispatch_pps={:.2} cycle_avg_ms={} cycle_p50_ms={} cycle_p95_ms={} snapshot_avg_ms={} planner_avg_ms={} freshness_reread_avg_ms={} freshness_validation_avg_ms={} dispatch_avg_ms={} post_observation_avg_ms={} dispatch_to_piece_advance_avg_ms={} piece_advance_to_cycle_avg_ms={} next_piece_wait_avg_ms={} action_avg={} lateral_avg={} rotation_avg={} hold_count={} route_mix={}",
+        placements,
+        effective_pps,
+        actual_dispatch_interval_avg_ms,
+        actual_dispatch_pps,
+        average_ms(samples.iter().map(|sample| sample.total_cycle_ms), placements),
+        percentile_ms(cycle_values.clone(), 50),
+        percentile_ms(cycle_values, 95),
+        average_ms(samples.iter().map(|sample| sample.snapshot_read_ms), placements),
+        average_ms(samples.iter().map(|sample| sample.planner_ms), placements),
+        average_ms(samples.iter().map(|sample| sample.freshness_reread_ms), placements),
+        average_ms(
+            samples
+                .iter()
+                .map(|sample| sample.freshness_validation_ms),
+            placements
+        ),
+        average_ms(samples.iter().map(|sample| sample.input_dispatch_ms), placements),
+        average_ms(
+            samples
+                .iter()
+                .map(|sample| sample.post_dispatch_observation_ms),
+            placements
+        ),
+        average_ms(
+            samples
+                .iter()
+                .map(|sample| sample.dispatch_to_piece_advance_ms),
+            placements
+        ),
+        average_ms(
+            samples
+                .iter()
+                .map(|sample| sample.piece_advance_to_cycle_start_ms),
+            placements
+        ),
+        average_ms(
+            samples.iter().map(|sample| sample.wait_for_next_piece_ms),
+            placements
+        ),
+        average_ms(samples.iter().map(|sample| sample.action_count as u128), placements),
+        average_ms(
+            samples
+                .iter()
+                .map(|sample| sample.lateral_action_count as u128),
+            placements
+        ),
+        average_ms(
+            samples
+                .iter()
+                .map(|sample| sample.rotation_action_count as u128),
+            placements
+        ),
+        samples.iter().filter(|sample| sample.hold_used).count(),
+        route_summary
+    )
+}
