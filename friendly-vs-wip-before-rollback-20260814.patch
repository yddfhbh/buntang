+#[derive(Clone, Debug)]
+struct FriendlyVsExpectedPostState {
+    field: Vec<[bool; 10]>,
+    lines_cleared: usize,
+}
+
+fn simulate_friendly_vs_expected_post_state(
+    snapshot: &FriendlyVsPassivePlannerSnapshot,
+    prepared: &PreparedSnapshotExecution,
+) -> Result<FriendlyVsExpectedPostState> {
+    friendly_vs_execution_piece(snapshot, prepared.summary.use_hold)
+        .context("friendly snapshot missing execution piece")?;
+    let mut board = snapshot.snapshot.board()?;
+    for piece in snapshot.snapshot.queue_pieces() {
+        board.add_next_piece(piece);
+    }
+    let queued_piece = board
+        .advance_queue()
+        .context("friendly snapshot queue must include the active piece")?;
+    let actual_piece = if prepared.summary.use_hold {
+        board.hold(queued_piece).unwrap_or_else(|| {
+            board
+                .advance_queue()
+                .expect("hold-first move requires at least one preview piece")
+        })
+    } else {
+        queued_piece
+    };
+    let target = FallingPiece {
+        kind: PieceState(actual_piece, prepared.summary.target_rotation.into()),
+        x: prepared.summary.target_x,
+        y: prepared.summary.target_y,
+        tspin: TspinStatus::None,
+    };
+    let lock = board.lock_piece(target);
+    Ok(FriendlyVsExpectedPostState {
+        field: board.get_field().into_iter().collect(),
+        lines_cleared: lock.cleared_lines.len(),
+    })
+}
+
+fn friendly_vs_expected_post_unavailable_reason(err: &anyhow::Error) -> &'static str {
+    let message = format!("{err:#}");
+    if message.contains("friendly snapshot missing execution piece") {
+        "missing_execution_piece"
+    } else if message.contains("friendly snapshot queue must include the active piece") {
+        "missing_active_piece"
+    } else {
+        "simulation_failed"
+    }
+}
