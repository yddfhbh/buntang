+fn build_skip_diagnostic(
+    snapshot: &GameSnapshot,
+    active_piece: PieceToken,
+    planned_move: &Move,
+    failure: &RouteSelectionFailure,
+) -> Option<PreparedSnapshotSkipDiagnostic> {
+    let reason = no_safe_route_reason(failure);
+    let diagnostic = RouteSearchFailureDiagnostic {
+        current_piece: active_piece,
+        target_piece: piece_token_from_piece(failure.target.kind.0),
+        use_hold: planned_move.hold,
+        from_x: failure.spawned.x,
+        from_y: failure.spawned.y,
+        from_rotation: rotation_token_from_state(failure.spawned.kind.1),
+        target_x: failure.target.x,
+        target_y: failure.target.y,
+        target_rotation: rotation_token_from_state(failure.target.kind.1),
+        board_hash: board_hash(snapshot.field.as_slice()),
+        candidate_count: failure.candidate_count,
+        rejected_count: failure.rejected_count,
+        rejected_route_samples: failure.rejected_route_samples.clone(),
+        reason: reason.clone(),
+    };
+    if reason.starts_with("no_route_to_target") {
+        Some(PreparedSnapshotSkipDiagnostic::NoRoute(diagnostic))
+    } else {
+        Some(PreparedSnapshotSkipDiagnostic::RouteFailure(diagnostic))
+    }
+}
