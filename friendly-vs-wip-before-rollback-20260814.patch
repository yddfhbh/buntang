+    fn write_friendly_vs_active_overlap_snapshot(
+        paths: &AppPaths,
+        round_id: &str,
+        gameid: &str,
+        candidate_id: &str,
+        piece_counter: u32,
+        userid: serde_json::Value,
+        current_piece: &str,
+        queue: &[&str],
+    ) {
+        let mut raw = friendly_vs_ready_snapshot_value(
+            round_id,
+            gameid,
+            candidate_id,
+            7,
+            piece_counter,
+            userid,
+            current_piece,
+            None,
+            queue,
+        );
+        write_friendly_vs_passive_snapshot_value(paths, &raw);
+        let parsed = read_test_friendly_vs_passive_snapshot(paths);
+        let active = parsed
+            .snapshot
+            .active
+            .expect("test active overlap snapshot should include active piece");
+        let current_piece: libtetris::Piece = parsed
+            .snapshot
+            .queue
+            .first()
+            .copied()
+            .expect("test active overlap snapshot should include current piece")
+            .into();
+        let active_piece = FallingPiece {
+            kind: PieceState(current_piece, active.rotation.into()),
+            x: active.x,
+            y: active.y,
+            tspin: TspinStatus::None,
+        };
+        let board = raw
+            .get_mut("snapshot")
+            .and_then(|value| value.get_mut("board"))
+            .and_then(serde_json::Value::as_array_mut)
+            .expect("snapshot board array");
+        for (x, y) in active_piece.cells() {
+            if !(0..10).contains(&x) || !(0..40).contains(&y) {
+                continue;
+            }
+            let row = board
+                .get_mut(y as usize)
+                .and_then(serde_json::Value::as_array_mut)
+                .expect("snapshot board row");
+            row[x as usize] = json!(1);
+        }
+        write_friendly_vs_passive_snapshot_value(paths, &raw);
+    }
