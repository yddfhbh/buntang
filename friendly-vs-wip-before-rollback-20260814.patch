+fn board_hash(field: &[[bool; 10]]) -> u64 {
+    let mut hash = 1469598103934665603u64;
+    for row in field {
+        for cell in row {
+            hash ^= u64::from(*cell as u8);
+            hash = hash.wrapping_mul(1099511628211);
+        }
+    }
+    hash
+}
+
+fn occupied_cell_count(field: &[[bool; 10]]) -> usize {
+    field
+        .iter()
+        .map(|row| row.iter().filter(|filled| **filled).count())
+        .sum()
+}
+
+fn board_topology_diagnostic(field: &[[bool; 10]]) -> BoardTopologyDiagnostic {
+    let visible_rows = 20usize;
+    let hidden_rows = field.len().saturating_sub(visible_rows);
+    let visible_occupied = occupied_cell_count(&field[..visible_rows]);
+    let hidden_occupied = occupied_cell_count(&field[visible_rows..]);
+    BoardTopologyDiagnostic {
+        width: 10,
+        height: field.len(),
+        row_orientation: "bottom_up",
+        hidden_rows,
+        visible_rows,
+        hidden_occupied,
+        visible_occupied,
+        occupied: visible_occupied + hidden_occupied,
+        board_hash: board_hash(field),
+        garbage_rows_known: false,
+    }
+}
+
+fn validate_target_on_board(
+    board: &Board,
+    target: FallingPiece,
+) -> TargetPlacementValidationDiagnostic {
+    let field = board.get_field();
+    let occupied_before = occupied_cell_count(&field);
+    let overlap_cells: Vec<(i32, i32)> = target
+        .cells()
+        .into_iter()
+        .filter(|(x, y)| board.occupied(*x, *y))
+        .take(4)
+        .collect();
+    let mut simulated = board.clone();
+    let lock = simulated.lock_piece(target);
+    let occupied_after = occupied_cell_count(&simulated.get_field());
+    let occupied_delta = occupied_after as isize - occupied_before as isize;
+    let expected_occupied_delta = 4 - (lock.cleared_lines.len() as isize * 10);
+    TargetPlacementValidationDiagnostic {
+        valid: overlap_cells.is_empty() && occupied_delta == expected_occupied_delta,
+        overlap_count: overlap_cells.len(),
+        overlap_cells,
+        occupied_before,
+        occupied_after,
+        occupied_delta,
+        expected_occupied_delta,
+        cleared_lines: lock.cleared_lines.len(),
+    }
+}
