+fn friendly_vs_semantic_invalid_log(
+    envelope: &FriendlyVsPassiveSnapshotEnvelope,
+    error: Option<&str>,
+) -> String {
+    let state = friendly_vs_semantic_invalid_state(envelope);
+    match error {
+        Some(error) => format!(
+            "[friendly-vs-dry-run] snapshot skipped reason=semantic_invalid state={state} error={error}"
+        ),
+        None => format!("[friendly-vs-dry-run] snapshot skipped reason=semantic_invalid state={state}"),
+    }
+}
