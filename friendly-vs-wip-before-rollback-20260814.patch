+        let Some(pending) = self
+            .friendly_vs_live
+            .pending_hold_transition()
+            .cloned()
+        else {
+            return FriendlyVsPendingHoldResolution::None;
+        };
+        if snapshot.round_id != pending.round_id
+            || snapshot.gameid != pending.gameid
+            || snapshot.capture_generation != pending.capture_generation
+            || snapshot.candidate_id != pending.candidate_id
+        {
+            let pending = self
+                .friendly_vs_live
+                .clear_pending_hold_transition()
+                .unwrap_or(pending);
+            self.push_log(format!(
+                "[friendly-vs-live] hold pending cleared reason=context_changed round_id={} gameid={} generation={} candidate={}",
+                pending.round_id,
+                pending.gameid,
+                pending.capture_generation,
+                pending.candidate_id
+            ));
+            return FriendlyVsPendingHoldResolution::Cleared;
+        }
+        if !snapshot.playing
+            || !snapshot.started
+            || snapshot.destroyed
+            || snapshot.successful
+            || snapshot.gameoverreason.is_some()
+        {
+            let pending = self
+                .friendly_vs_live
+                .clear_pending_hold_transition()
+                .unwrap_or(pending);
+            self.push_log(format!(
+                "[friendly-vs-live] hold pending cleared reason=not_playing round_id={} gameid={} generation={} candidate={}",
+                pending.round_id,
+                pending.gameid,
+                pending.capture_generation,
+                pending.candidate_id
+            ));
+            return FriendlyVsPendingHoldResolution::Cleared;
+        }
+        let evaluation = evaluate_friendly_vs_hold_transition(&pending, snapshot);
+        if !evaluation.confirmed {
+            return FriendlyVsPendingHoldResolution::Waiting;
+        }
+        let pending = self
+            .friendly_vs_live
+            .clear_pending_hold_transition()
+            .unwrap_or(pending);
+        self.push_log(format!(
+            "[friendly-vs-live] hold transition confirmed reason={} before_piece_counter={} observed_piece_counter={} before_current={} before_hold={} observed_current={} observed_hold={} hold_changed={} queue_changed={} piece_counter_changed={} elapsed_ms={}",
+            evaluation.reason,
+            piece_counter_label(evaluation.before_piece_counter),
+            piece_counter_label(evaluation.after_piece_counter),
+            evaluation.before_current.map(|piece| piece.label()).unwrap_or("?"),
+            evaluation.before_hold.map(|piece| piece.label()).unwrap_or("-"),
+            evaluation.after_current.map(|piece| piece.label()).unwrap_or("?"),
+            evaluation.after_hold.map(|piece| piece.label()).unwrap_or("-"),
+            evaluation.hold_changed,
+            evaluation.queue_changed,
+            evaluation.piece_counter_changed,
+            self.monotonic_now()
+                .duration_since(pending.dispatched_at)
+                .as_millis()
+        ));
+        FriendlyVsPendingHoldResolution::Confirmed
+    }
